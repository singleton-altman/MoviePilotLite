<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/widget_row_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="5dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/row_poster"
        android:layout_width="24dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_poster_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/row_date"
        android:layout_width="44dp"
        android:layout_height="28dp"
        android:background="@drawable/widget_date_badge_default"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2F6FC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9BA9BC"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:textColor="#7DD3FC"
        android:textSize="9sp" />
</LinearLayout>
